# Optional Google Cloud Translation API key. Keep the real value in .env or your secret manager.
GOOGLE_TRANSLATE_API_KEY=
APP_PORT=8080
# Optional allowed origin if the API/translation proxy is accessed directly.
APP_ORIGIN=
# Set true when the public deployment uses HTTPS.
COOKIE_SECURE=false
# Shared API bootstrap administrator. Change these before any deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mamaafrica
# Set a stable secret in production; document files are encrypted with it.
DOCUMENT_ENCRYPTION_KEY=
